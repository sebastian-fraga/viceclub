---
import { CheatsContainer } from "@/components/cheats/CheatsContainer";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadCheats } from "@/lib/cheats/loadCheats";

export function getStaticPaths() {
    const availableGames = Object.entries(games).filter(([, gameData]) =>
        loadCheats(gameData.id as GameId),
    );

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game]) => ({
            params: { locale, game },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = getPageSeo(
    game,
    "trucos",
    LOCALE_TO_LANG[locale as LocaleSlug],
);

if (!gameData) {
    throw new Error(`Game not found: ${game}`);
}

const gameId = gameData.id as GameId;
const cheatsData = loadCheats(gameId);

if (!cheatsData) {
    throw new Error(`Cheats file not found for game: ${gameId}`);
}
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/trucos`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] md:ml-(--sidebar-width) md:gap-45 pb-64"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <CheatsContainer
            cheatsData={cheatsData}
            platforms={gameData.platforms}
            game={gameId}
            client:load
        />
    </main>
</BaseLayout>
