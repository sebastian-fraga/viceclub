---
import { getMediaData } from "@/components/artworks/getMediaData";
import { MediaGallery } from "@/components/artworks/MediaGallery";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    const availableGames = Object.entries(games).filter(([, gameData]) =>
        getMediaData(gameData.id),
    );

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game]) => ({
            params: { locale, game },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const pageSeo = getPageSeo(
    game,
    "artworks",
    LOCALE_TO_LANG[locale as LocaleSlug],
);

if (!gameData) {
    throw new Error(`Game not found: ${game}`);
}

const gameId = gameData.id;
const mediaData = getMediaData(gameId);

if (!mediaData) {
    throw new Error(`Media data not found for ${gameId}`);
}
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/artworks`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col bg-linear-135 from-[#15151F] to-[#1E1E33] pb-64 max-mobile:pb-48 md:ml-(--sidebar-width) mobile:px-8"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <MediaGallery client:load gameId={gameId} data={mediaData} />
    </main>
</BaseLayout>
