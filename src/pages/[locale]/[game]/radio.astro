---
import { getRadioData } from "@/components/radio/lib/getRadioData";
import { parseRadioData } from "@/components/radio/lib/parseRadioData";
import RadioPage from "@/components/radio/RadioPage";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    const availableGames = Object.entries(games).filter(([, gameData]) =>
        getRadioData(gameData.id),
    );

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game]) => ({
            params: { locale, game },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = getPageSeo(game, "radio", LOCALE_TO_LANG[locale as LocaleSlug]);

if (!gameData) {
    throw new Error(`Game not found: ${game}`);
}

const gameId = gameData.id;
const radioDataRaw = getRadioData(gameId);

if (!radioDataRaw) {
    throw new Error(`Radio data not found for ${gameId}`);
}

const stations = parseRadioData(radioDataRaw);
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/radio`}
    game={gameData}
>
    <main
        style="padding-top: var(--header-height); transition: margin-left 0.3s;"
        class="ml-0 mt-30 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] md:ml-(--sidebar-width) md:gap-45 pb-64"
    >
        <section
            class="mx-auto flex w-full max-w-350 flex-col gap-8 max-mobile:gap-20 max-mobile:px-4 max-mobile:pb-12 mobile:px-6"
        >
            <RadioPage
                client:load
                stations={stations}
                station={stations[0]}
                game={gameId}
            />
        </section>
    </main>
</BaseLayout>
