---
import ModsContainer from "@/components/mods/ModsContainer";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { GAME_MODS } from "@/data/mods";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return LOCALES.flatMap((locale) =>
        Object.entries(GAME_MODS).map(([game]) => ({
            params: { locale, game },
            props: {
                gameData: games[game as GameId],
            },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as keyof typeof GAME_MODS;
const gameData = games[game as GameId];
const modsData = GAME_MODS[game];
const pageSeo = getPageSeo(
    game as GameId,
    "herramientas-y-mods",
    LOCALE_TO_LANG[locale as LocaleSlug],
);
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/herramientas-y-mods`}
    game={gameData}
>
    <main class="mt-4">
        <ModsContainer client:load gameId={game} mods={modsData.mods} />
    </main>
</BaseLayout>
