---
import UnderConstruction from "@/components/404/UnderConstruction";
import ModsContainer from "@/components/mods/ModsContainer";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { GAME_MODS } from "@/data/mods";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    const availableGames = [
        ...Object.keys(GAME_MODS),
        "VI",
    ] as GameId[];

    return LOCALES.flatMap((locale) =>
        availableGames.map((game) => ({
            params: { locale, game },
            props: {
                gameData: games[game],
            },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const modsData = GAME_MODS[game as keyof typeof GAME_MODS];
const pageSeo = getPageSeo(
    game as GameId,
    "herramientas-y-mods",
    LOCALE_TO_LANG[locale as LocaleSlug],
);
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/herramientas-y-mods`}
    game={gameData}
>
    <main class="mt-4">
        {game === "VI" || !modsData ? (
            <UnderConstruction gameId={game} client:load />
        ) : (
            <ModsContainer client:load gameId={game} mods={modsData.mods} />
        )}
    </main>
</BaseLayout>
