---
import GameMap from "@/components/maps/GameMap";
import "@/components/maps/map.css";
import type { GameId } from "@/config/games";
import { LOCALES } from "@/config/languages";
import { games } from "@/data/games";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    const availableGames = Object.entries(seo).filter(([, pages]) => pages?.mapa);

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game]) => ({
            params: { locale, game },
            props: {
                gameData: games[game as GameId],
            },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = seo[game]?.mapa;
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/mapa`}
    game={gameData}
>
    <main
        class="ml-0 bg-linear-135 from-[#15151F] to-[#1E1E33] md:ml-(--sidebar-width)"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
        id="map-main"
    >
        <div class="h-screen">
            <GameMap client:only="react" gameId={game} />
        </div>

        <div class="h-48 max-mobile:h-22"></div>
    </main>
</BaseLayout>
