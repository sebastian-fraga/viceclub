---
import GameHome from "@/components/home/GameHome.astro";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return LOCALES.flatMap((locale) =>
        Object.entries(games).map(([game, gameData]) => ({
            params: { locale, game },
            props: { gameData },
        })),
    );
}

const { locale, game } = Astro.params;
const gameData = games[game as keyof typeof games];
const gameSeo = getPageSeo(
    game as GameId,
    "inicio",
    LOCALE_TO_LANG[locale as LocaleSlug],
);
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/inicio`}
    game={gameData}
>
    <main>
        <GameHome game={gameData} />
    </main>
</BaseLayout>
