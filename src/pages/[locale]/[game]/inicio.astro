---
import GameHome from "@/components/home/GameHome.astro";
import { LOCALES } from "@/config/languages";
import { games } from "@/data/games";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return LOCALES.flatMap((locale) =>
        Object.entries(games).map(([game, gameData]) => ({
            params: { locale, game },
            props: { gameData },
        })),
    );
}

const { locale, game } = Astro.params;
const gameData = games[game as keyof typeof games];
const gameSeo = seo[game as keyof typeof games]?.inicio;
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/inicio`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] pb-62 max-mobile:pb-32 md:ml-(--sidebar-width) md:gap-45"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <GameHome game={gameData} />
    </main>
</BaseLayout>
