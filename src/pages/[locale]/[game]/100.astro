---
import { ChecklistContainer } from "@/components/checklist/ChecklistContainer";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ChecklistData } from "@/types/checklist";

export function getStaticPaths() {
    const checklistModules = import.meta.glob(
        "../../../data/checklists/*.json",
        {
            eager: true,
        },
    );

    const availableGames = Object.entries(games).filter(([game]) =>
        Object.keys(checklistModules).some((path) =>
            path.endsWith(`/checklists/${game}.json`),
        ),
    );

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game, gameData]) => ({
            params: { locale, game },
            props: { gameData },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const pageSeo = getPageSeo(game, "100", LOCALE_TO_LANG[locale as LocaleSlug]);

const checklistModules = import.meta.glob("../../../data/checklists/*.json", {
    eager: true,
});

const checklistEntry = Object.entries(checklistModules).find(([path]) =>
    path.endsWith(`/checklists/${game}.json`),
);

if (!checklistEntry) {
    throw new Error(`No se encontró checklist para el juego "${game}"`);
}

const data = (checklistEntry[1] as { default: ChecklistData }).default;
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/100`}
    game={gameData}
>
    <main class="mt-4">
        <ChecklistContainer
            game={game}
            variantId={game}
            data={data}
            client:load
        />
    </main>
</BaseLayout>
