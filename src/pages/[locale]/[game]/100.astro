---
import UnderConstruction from "@/components/404/UnderConstruction";
import { ChecklistContainer } from "@/components/checklist/ChecklistContainer";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ChecklistData } from "@/types/checklist";

export function getStaticPaths() {
    return LOCALES.flatMap((locale) =>
        Object.entries(games).map(([game, gameData]) => ({
            params: { locale, game },
            props: { gameData },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const pageSeo = getPageSeo(game, "100", LOCALE_TO_LANG[locale as LocaleSlug]);

const checklistModules = import.meta.glob<{ default: ChecklistData }>(
    "../../../data/checklists/*.json",
);

const checklistPath = `../../../data/checklists/${game}.json`;
const checklistLoader = checklistModules[checklistPath];

const data =
    game === "VI"
        ? null
        : checklistLoader
          ? (await checklistLoader()).default
          : null;

if (game !== "VI" && !data) {
    throw new Error(`No se encontró checklist para el juego "${game}"`);
}
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/100`}
    game={gameData}
>
    <main class="mt-4">
        {game === "VI" ? (
            <UnderConstruction 
                gameId={game} 
                client:load 
            />
        ) : (
            <ChecklistContainer
                game={game}
                variantId={game}
                data={data!}
                client:load
            />
        )}
    </main>
</BaseLayout>
