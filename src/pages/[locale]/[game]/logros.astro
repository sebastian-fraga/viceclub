---
import UnderConstruction from "@/components/404/UnderConstruction";
import type { GameId } from "@/config/games";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { games } from "@/data/games";
import { getPageSeo } from "@/data/seo/getSeo";
import { seo } from "@/data/seo/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    const availableGames = Object.entries(seo).filter(
        ([, pages]) => pages?.logros,
    );

    return LOCALES.flatMap((locale) =>
        availableGames.map(([game]) => ({
            params: { locale, game },
            props: {
                gameData: games[game as GameId],
            },
        })),
    );
}

const { locale } = Astro.params;
const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = getPageSeo(
    game,
    "logros",
    LOCALE_TO_LANG[locale as LocaleSlug],
);
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/logros`}
    game={gameData}
>
    <main class="flex min-h-screen flex-col items-center justify-center">
        <UnderConstruction client:load gameId={game} />
    </main>
</BaseLayout>
