---
import type { TimelineData } from "@/components/timeline/Timeline";
import Timeline from "@/components/timeline/Timeline";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { GTAVI } from "@/data/games/VI";
import { getPageSeo } from "@/data/seo/getSeo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
    let timelineData: TimelineData | null = null;

    try {
        const response = await fetch(
            "https://viceclub.s3.us-east-1.amazonaws.com/VI/timeline.json",
        );

        if (response.ok) {
            timelineData = await response.json();
        } else {
            console.error(
                `Error al cargar timeline.json para VI: ${response.status}`,
            );
        }
    } catch (err) {
        console.error("Error al cargar timeline.json para VI:", err);
    }

    return LOCALES.map((locale) => ({
        params: { locale },
        props: { timelineData },
    }));
}

const { locale } = Astro.params;
const { timelineData } = Astro.props;
const game = "VI";
const gameData = GTAVI;
const gameSeo = getPageSeo(
    game,
    "timeline",
    LOCALE_TO_LANG[locale as LocaleSlug],
);
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${locale}/${game}/timeline`}
    game={gameData}
>
    <main
    >
        <Timeline gameCode={game} initialData={timelineData} client:load />
    </main>
</BaseLayout>
