---
import BaseLayout from "@/layouts/BaseLayout.astro";

import GameCarousel from "@/components/index/carousel/GameCarousel";
import Countdown from "@/components/index/countdown/Countdown";
import Faq from "@/components/index/faq/Faq";
import Hero from "@/components/index/hero/Hero";
import News from "@/components/index/news/News";
import { LOCALES, LOCALE_TO_LANG, type LocaleSlug } from "@/config/languages";
import { homeSeo } from "@/data/seo/homeSeo";

export function getStaticPaths() {
    return LOCALES.map((locale) => ({
        params: { locale },
    }));
}

const { locale } = Astro.params;
const pageSeo = homeSeo[LOCALE_TO_LANG[locale as LocaleSlug]];
---

<BaseLayout
    title={pageSeo.title}
    description={pageSeo.description}
    canonical={`https://www.viceclub.app/${locale}`}
>
    <main>
        <Hero client:load />

        <div
            class="w-full max-w-400 mx-auto max-mobile:px-4 mobile:px-6 flex flex-col max-mobile:gap-36 md:gap-45 mb-12"
        >
            <Countdown client:load />

            <GameCarousel client:load />

            <News client:load />

            <Faq client:visible />
        </div>
    </main>
</BaseLayout>
