---
import BaseLayout from "../layouts/BaseLayout.astro";

import GameCarousel from "../components/carousel/GameCarousel";
import Countdown from "../components/index/countdown/Countdown";
import Faq from "../components/index/faq/Faq";
import Hero from "../components/index/hero/Hero";
import News from "../components/index/news/News";
---

<BaseLayout
    title="Vice Club | La página definitiva de la saga GTA"
    description="Guías completas de GTA, checklists para el 100%, mapas interactivos, mods, trucos y radios de GTA San Andreas, GTA 5, GTA 6 y más"
    canonical="https://www.viceclub.app"
>
    <main
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
        class="ml-0 md:ml-(--sidebar-width) bg-linear-135 from-[#15151F] to-[#1E1E33] flex flex-col gap-16 md:gap-45 pb-12"
    >
        <Hero client:load />

        <div
            class="w-full max-w-400 mx-auto max-mobile:px-4 mobile:px-6 flex flex-col gap-16 md:gap-45 mb-12"
        >
            <Countdown client:load />

            <GameCarousel client:load />

            <News client:load />

            <Faq client:load />
        </div>
    </main>
</BaseLayout>
