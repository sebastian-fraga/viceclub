---
import type { GameId } from "@/config/games";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { games } from "../../data/games";

import { CheatsContainer } from "@/components/cheats/CheatsContainer";
import { loadCheats } from "@/lib/cheats/loadCheats.ts";

export function getStaticPaths() {
    return Object.entries(games)
        .filter(([_, gameData]) => loadCheats(gameData.id as GameId))
        .map(([game]) => ({
            params: { game },
        }));
}

const { game } = Astro.params;

const gameData = games[game as keyof typeof games];

if (!gameData) {
    throw new Error(`Game not found: ${game}`);
}

const gameId = gameData.id as GameId;
const gameKey = String(gameId).toLowerCase();

const cheatsData = loadCheats(gameId);

if (!cheatsData) {
    throw new Error(`Cheats file not found for game: ${gameId}`);
}

const metadata = {
    iii: {
        title: "GTA III Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA 3: Trucos para PlayStation, Xbox, Nintendo Switch y PC.",
        bodyClass: "gta-3",
        heading: "Trucos de Grand Theft Auto III",
    },
    vc: {
        title: "GTA VC Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA Vice City: Trucos para PlayStation, Xbox y PC.",
        bodyClass: "gta-vc",
        heading: "Trucos de Grand Theft Auto: Vice City",
    },
    sa: {
        title: "GTA SA Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA San Andreas: Trucos para PlayStation, Xbox, Nintendo Switch y PC.",
        bodyClass: "gta-sa",
        heading: "Trucos de Grand Theft Auto: San Andreas",
    },
    lcs: {
        title: "GTA LCS Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA Liberty City Stories: Trucos para PlayStation y PC.",
        bodyClass: "gta-lcs",
        heading: "Trucos de Grand Theft Auto: Liberty City Stories",
    },
    vcs: {
        title: "GTA VCS Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA Vice City Stories: Trucos para PlayStation y PC.",
        bodyClass: "gta-vcs",
        heading: "Trucos de Grand Theft Auto: Vice City Stories",
    },
    iv: {
        title: "GTA IV Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA 4: Trucos para PlayStation, Xbox y PC.",
        bodyClass: "gta-4",
        heading: "Trucos de Grand Theft Auto IV",
    },
    v: {
        title: "GTA V Trucos | Lista Completa | Vice Club",
        description:
            "Todos los trucos para GTA 5: Trucos para PlayStation, Xbox y PC.",
        bodyClass: "gta-5",
        heading: "Trucos de Grand Theft Auto V",
    },
};

const meta = metadata[gameKey as keyof typeof metadata] || metadata.vc;
---

<BaseLayout
    title={meta.title}
    description={meta.description}
    canonical={`https://www.viceclub.app/${gameKey}/trucos`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] pb-12 md:ml-(--sidebar-width) md:gap-45"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <CheatsContainer
            cheatsData={cheatsData}
            platforms={gameData.platforms}
            game={gameId}
            client:load
        />
    </main>
</BaseLayout>
