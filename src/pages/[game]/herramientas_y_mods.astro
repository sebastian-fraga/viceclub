---
import type { GameId } from "@/config/games";
import { games } from "../../data/games";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { IconArrowLeft } from "@tabler/icons-react";

export function getStaticPaths() {
    return Object.entries(games).map(([game, gameData]) => ({
        params: { game },
        props: { gameData },
    }));
}

const game = Astro.params.game as GameId;
const gameData = games[game as keyof typeof games];

const metadata = {
    III: {
        title: "Mods y Herramientas de GTA III | Vice Club",
        description:
            "Explora herramientas y mods para la versión de PC de GTA 3. Lista de mods esenciales, fixes, y modificaciones que mejoran tu jugabilidad en Grand Theft Auto III.",
        bodyClass: "gta-3",
        heading: "Herramientas y Mods para Grand Theft Auto III",
        paragraph:
            "Si deseas tener la mejor experiencia al jugar a <b>Grand Theft Auto III</b> en PC, es recomendable usar algunos mods esenciales. Aquí encontrarás las herramientas imprescindibles para corregir errores, mejorar la compatibilidad y optimizar el rendimiento, entre otras cosas",
        soundDelay: null,
    },
    VC: {
        title: "Mods y Herramientas de GTA Vice City | Vice Club",
        description:
            "Explora herramientas y mods para la versión de PC de GTA VC. Lista de mods esenciales, fixes, y modificaciones que mejoran tu jugabilidad en Grand Theft Auto: Vice City.",
        bodyClass: "gta-vc",
        heading: "Herramientas y Mods para Grand Theft Auto: Vice City",
        paragraph:
            "Si deseas tener la mejor experiencia al jugar a <b>Grand Theft Auto: Vice City</b> en PC, es recomendable usar algunos mods esenciales. Aquí encontrarás las herramientas imprescindibles para corregir errores, mejorar la compatibilidad y optimizar el rendimiento, entre otras cosas",
        soundDelay: null,
    },
    SA: {
        title: "Mods y Herramientas de GTA San Andreas | Vice Club",
        description:
            "Explora herramientas y mods para la versión de PC de GTA SA. Lista de mods esenciales, fixes, y modificaciones que mejoran tu jugabilidad en Grand Theft Auto: San Andreas.",
        bodyClass: "gta-sa",
        heading: "Herramientas y Mods para Grand Theft Auto: San Andreas",
        paragraph:
            "Si deseas tener la mejor experiencia al jugar a <b>Grand Theft Auto: San Andreas</b> en PC, es recomendable usar algunos mods esenciales. Aquí encontrarás las herramientas imprescindibles para corregir errores, mejorar la compatibilidad y optimizar el rendimiento, entre otras cosas",
        soundDelay: 200,
    },
    IV: {
        title: "Mods y Herramientas de GTA IV | Vice Club",
        description:
            "Explora herramientas y mods para la versión de PC de GTA 4. Lista de mods esenciales, fixes, y modificaciones que mejoran tu jugabilidad en Grand Theft Auto IV.",
        bodyClass: "gta-4",
        heading: "Herramientas y Mods para Grand Theft Auto IV",
        paragraph:
            "Si deseas tener la mejor experiencia al jugar a <b>Grand Theft Auto IV</b> en PC, es recomendable usar algunos mods esenciales. Aquí encontrarás las herramientas imprescindibles para corregir errores, mejorar la compatibilidad y optimizar el rendimiento, entre otras cosas",
        soundDelay: null,
    },
    V: {
        title: "Mods y Herramientas de GTA V | Vice Club",
        description:
            "Explora herramientas y mods para la versión de PC de GTA 5. Lista de mods esenciales, fixes, y modificaciones que mejoran tu jugabilidad en Grand Theft Auto V.",
        bodyClass: "gta-5",
        heading: "Herramientas y Mods para Grand Theft Auto V",
        paragraph:
            "Si deseas tener la mejor experiencia al jugar a <b>Grand Theft Auto V</b> en PC, es recomendable usar algunos mods esenciales. Aquí encontrarás las herramientas imprescindibles para corregir errores, mejorar la compatibilidad y optimizar el rendimiento, entre otras cosas",
        soundDelay: 400,
    },
};

const meta = metadata[game as keyof typeof metadata] || metadata.VC;
---

<BaseLayout
    title={`${gameData.title} | Vice Club`}
    description={gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/herramientas_y_mods`}
    game={gameData}
>
    <main class="flex flex-col min-h-screen items-center justify-center">
        <h2 class="text-4xl font-bold text-white">UNDER CONSTRUCTION</h2>
        <a
            class="mt-3 bg-indigo-300 px-8 py-3 text-xl text-indigo-900 font-medium rounded-full flex items-center gap-2 transition-all hover:bg-indigo-400 hover:text-indigo-50"
            href="/"
        >
            <IconArrowLeft />
            Back
        </a>
    </main>
</BaseLayout>
