---
import { getRadioData } from "@/components/radio/lib/getRadioData";
import { parseRadioData } from "@/components/radio/lib/parseRadioData";
import RadioPlayer from "@/components/radio/RadioPlayer";
import type { GameId } from "@/config/games";
import { games } from "@/data/games";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return Object.entries(games)
        .filter(([, gameData]) => getRadioData(gameData.id))
        .map(([game]) => ({
            params: { game },
        }));
}

const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = seo[game]?.radio;

if (!gameData) {
    throw new Error(`Game not found: ${game}`);
}

const gameId = gameData.id;
const radioDataRaw = getRadioData(gameId);

if (!radioDataRaw) {
    throw new Error(`Radio data not found for ${gameId}`);
}

const stations = parseRadioData(radioDataRaw);
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/radio`}
    game={gameData}
>
    <main
        style="padding-top: var(--header-height); transition: margin-left 0.3s;"
        class="ml-0 mt-30 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] pb-20 md:ml-(--sidebar-width) md:gap-45"
    >
        <section
            class="mx-auto flex w-fit max-w-400 flex-col gap-8 max-mobile:w-full max-mobile:gap-20 max-mobile:px-4 max-mobile:pb-12 mobile:px-6"
        >
            <RadioPlayer client:load stations={stations} game={gameId} />
        </section>
    </main>
</BaseLayout>
