---
import UnderConstruction from "@/components/404/UnderConstruction";
import type { GameId } from "@/config/games";
import { games } from "@/data/games";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return Object.entries(seo)
        .filter(([, pages]) => pages?.mapa)
        .map(([game]) => ({
            params: { game },
            props: {
                gameData: games[game as GameId],
            },
        }));
}

const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = seo[game]?.mapa;
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/mapa`}
    game={gameData}
>
    <main class="flex min-h-screen flex-col items-center justify-center">
        <UnderConstruction client:load gameId={game} />
    </main>
</BaseLayout>
