---
import GameMap from "@/components/maps/GameMap";

import type { GameId } from "@/config/games";
import { games } from "@/data/games";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

import "../../components/maps/map.css";

export function getStaticPaths() {
    return Object.entries(seo)
        .filter(([, pages]) => pages?.mapa)
        .map(([game]) => ({
            params: { game },
            props: {
                gameData: games[game as GameId],
            },
        }));
}

const game = Astro.params.game as GameId;
const gameData = games[game];
const gameSeo = seo[game]?.mapa;
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/mapa`}
    game={gameData}
>
    <main
        class="ml-0 h-screen bg-linear-135 from-[#15151F] to-[#1E1E33] md:ml-(--sidebar-width)"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <GameMap client:only="react" gameId={game} />
    </main>
</BaseLayout>
