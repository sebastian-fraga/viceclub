---
import { seo } from "@/data/seo";

import GameHome from "@/components/home/GameHome.astro";
import { games } from "../../data/games";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
    return Object.entries(games).map(([game, gameData]) => ({
        params: { game },
        props: { gameData },
    }));
}

const { game } = Astro.params;
const gameData = games[game as keyof typeof games];
const gameSeo = seo[game as keyof typeof games]?.inicio;
---

<BaseLayout
    title={gameSeo
        ? `${gameSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={gameSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/inicio`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] pb-12 md:ml-(--sidebar-width) md:gap-45"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <GameHome game={gameData} />
    </main>
</BaseLayout>
