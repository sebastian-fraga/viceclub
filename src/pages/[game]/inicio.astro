---
import GameHome from "@/components/home/GameHome.astro";
import { GTAIII } from "../../data/games/III";
import { GTASA } from "../../data/games/SA";
import { GTAVC } from "../../data/games/VC";
import { GTALCS } from "../../data/games/LCS";
import { GTAVCS } from "../../data/games/VCS";
import { GTAIV } from "../../data/games/IV";
import { GTAV } from "../../data/games/V";
import { GTAVI } from "../../data/games/VI";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
    const games = {
        III: GTAIII,
        VC: GTAVC,
        SA: GTASA,
        LCS: GTALCS,
        VCS: GTAVCS,
        IV: GTAIV,
        V: GTAV,
        VI: GTAVI,
    };

    return Object.entries(games).map(([game, gameData]) => ({
        params: { game },
        props: { gameData },
    }));
}

const { game } = Astro.params;
const { gameData } = Astro.props;
---

<BaseLayout
    title={`${gameData.title} | Vice Club`}
    description={gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/inicio`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] pb-12 md:ml-(--sidebar-width) md:gap-45"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <GameHome game={gameData} />
    </main>
</BaseLayout>
