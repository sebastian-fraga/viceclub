---
import ModsContainer from "@/components/mods/ModsContainer";

import type { GameId } from "@/config/games";
import { games } from "@/data/games";
import { GAME_MODS } from "@/data/mods";
import { seo } from "@/data/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
    return Object.entries(GAME_MODS).map(([game]) => ({
        params: { game },
        props: {
            gameData: games[game as GameId],
        },
    }));
}

const game = Astro.params.game as keyof typeof GAME_MODS;
const gameData = games[game as GameId];
const modsData = GAME_MODS[game];
const pageSeo = seo[game as GameId]?.["herramientas-y-mods"];
---

<BaseLayout
    title={pageSeo
        ? `${pageSeo.title} | Vice Club`
        : `${gameData.title} | Vice Club`}
    description={pageSeo?.description ?? gameData.description.paragraphs[0]}
    canonical={`https://www.viceclub.app/${game}/herramientas-y-mods`}
    game={gameData}
>
    <main
        class="ml-0 flex flex-col gap-16 bg-linear-135 from-[#15151F] to-[#1E1E33] mt-8 pb-12 md:ml-(--sidebar-width) md:gap-45"
        style="padding-top: calc(var(--header-height) + var(--banner-height)); transition: margin-left 0.3s;"
    >
        <ModsContainer client:load gameId={game} mods={modsData.mods} />
    </main>
</BaseLayout>
