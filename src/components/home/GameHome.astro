---
import type { Game } from "@/types/game";

import charactersData from "../../data/characters.json";
import GamePage from "../home/GamePage";

export async function getStaticPaths() {
    const gameFiles = import.meta.glob<{ default: Game }>(
        "../../data/games/*.ts",
        { eager: true },
    );

    return Object.values(gameFiles).map(({ default: game }) => ({
        params: { game: game.id },
        props: { game },
    }));
}

const { game } = Astro.props;

---

<div
    class="w-full max-w-400 mx-auto max-mobile:px-4 mobile:px-6 flex flex-col gap-22 max-mobile:gap-8 mb-12 mt-8"
>
    <GamePage client:load game={game} charactersData={charactersData} />
</div>
