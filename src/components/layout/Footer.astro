---
import { APP_VERSION, COMMIT } from "@/lib/app/version";

import { IconBrandGithub, IconBrandX, IconMail } from "@tabler/icons-react";

import Support from "../index/support/Support";

const anchorClasses =
    "text-black bg-white p-2 mobile:px-8 mobile:py-3 rounded-full transition";
---

<footer
    style="transition: margin-left 0.3s;"
    class="ml-0 mobile:ml-(--sidebar-width) pt-10 pb-22 text-neutral-50 gap-10 flex flex-col border-t border-t-slate-800 overflow-hidden"
>
    <div
        class="flex flex-col lg:flex-row items-center justify-between w-full gap-8 px-6 mobile:px-12 lg:px-32"
    >
        <div class="relative flex items-center gap-4 shrink-0">
            <div
                class="absolute inset-0 z-0 bg-linear-to-r from-pink-700/40 via-yellow-300/40 to-blue-500/40 blur-3xl"
            >
            </div>

            <img
                class="relative z-1 w-[4em] max-mobile:w-15"
                src="/assets/images/app/logo.webp"
                alt="Vice Club Logo"
                loading="lazy"
            />

            <span
                class="relative z-1 select-none text-center font-body-condensed text-5xl tracking-tight text-blue-400 [-webkit-text-stroke:2px_#101525aa] max-mobile:text-[2.3em]"
            >
                VICE CLUB
            </span>
        </div>

        <div
            class="flex flex-wrap items-center justify-center lg:justify-end gap-x-10 gap-y-6 w-full lg:w-auto"
        >
            <nav aria-label="Redes🌴" class="flex items-center gap-3">
                <a
                    href="https://github.com/sebastian-fraga/viceclub"
                    aria-label="GitHub"
                    class=`${anchorClasses} hover:bg-pink-100`
                >
                    <IconBrandGithub stroke={1.5} />
                </a>

                <a
                    href="https://x.com/ViceClubApp"
                    aria-label="X"
                    class=`${anchorClasses} hover:bg-yellow-100`
                >
                    <IconBrandX stroke={1.5} />
                </a>

                <a
                    href="mailto:contact@viceclub.app"
                    aria-label="Email"
                    class=`${anchorClasses} hover:bg-blue-100`
                >
                    <IconMail stroke={1.5} />
                </a>
            </nav>

            <Support client:idle />
        </div>
    </div>

    <div
        class="flex flex-col mobile:flex-row items-center justify-center gap-2 mobile:gap-3 text-base text-center"
    >
        <span class="text-slate-300 font-extrabold">
            © {new Date().getFullYear()} VICE CLUB
        </span>

        <span class="hidden mobile:inline text-slate-500"> • </span>

        <span class="text-slate-300 font-thin">
            v{APP_VERSION} •{" "}

            <a
                href={`https://github.com/sebastian-fraga/viceclub/commit/${COMMIT}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-slate-100 transition underline decoration-slate-600 underline-offset-2"
            >
                {COMMIT}
            </a>
        </span>
    </div>
</footer>
