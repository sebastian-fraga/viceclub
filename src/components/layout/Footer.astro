---
import { APP_VERSION, COMMIT } from "@/lib/app/version";

import { IconBrandGithub, IconBrandX, IconMail } from "@tabler/icons-react";

import Support from "../index/support/Support";

const anchorClasses =
    "text-black bg-white p-2 mobile:px-6 mobile:py-2 rounded-full transition hover:bg-pink-100";
---

<footer
    style="transition: margin-left 0.3s;"
    class="ml-0 mobile:ml-(--sidebar-width) py-5 text-neutral-50 gap-4 flex flex-col border-t border-t-slate-800"
>
    <div
        class="flex flex-col mobile:flex-row items-center justify-between w-full gap-6 px-4 mobile:px-12"
    >
        <div
            class="flex items-center gap-4 drop-shadow-lg drop-shadow-cyan-500/15"
        >
            <img
                src="/assets/images/app/logo.webp"
                alt="Logo de Vice Club"
                class="w-24 mobile:w-auto max-mobile:w-12"
                loading="lazy"
            />
            <span
                class="select-none text-center font-body-condensed text-2xl transition-all duration-200 ease-in-out [-webkit-text-stroke:1px_#00000077] [-webkit-text-fill-color:transparent] max-mobile:text-[2.3em] bg-linear-to-br from-blue-300 to-blue-500 bg-clip-text text-transparent"
                >VICE CLUB</span
            >
        </div>

        <div
            class="flex flex-col mobile:flex-row items-center gap-6 mobile:gap-10"
        >
            <div class="flex items-center gap-3">
                <a
                    href="https://github.com/sebastian-fraga/viceclub"
                    class={anchorClasses}
                >
                    <IconBrandGithub stroke={1.5} />
                </a>

                <a href="https://x.com/ViceClubApp" class={anchorClasses}>
                    <IconBrandX stroke={1.5} />
                </a>

                <a
                    href="mailto:fragasebastian1@gmail.com"
                    class={anchorClasses}
                >
                    <IconMail stroke={1.5} />
                </a>
            </div>

            <Support client:load />
        </div>
    </div>

    <div
        class="flex flex-col mobile:flex-row items-center justify-center gap-2 mobile:gap-3 border-t border-slate-700/20 pt-4 pb-2 text-sm text-center"
    >
        <span class="text-slate-300 font-extrabold">
            © {new Date().getFullYear()} VICE CLUB
        </span>

        <span class="hidden mobile:inline text-slate-500"> • </span>

        <span class="text-slate-300 font-thin">
            v{APP_VERSION} •{" "}

            <a
                href={`https://github.com/sebastian-fraga/viceclub/commit/${COMMIT}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-slate-100
            transition underline decoration-slate-600 underline-offset-2"
            >
                {COMMIT}
            </a>
        </span>
    </div>
</footer>
