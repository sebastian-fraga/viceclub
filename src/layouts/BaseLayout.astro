---
import { ClientRouter } from "astro:transitions";

import type { Game } from "@/types/game";
import { defaultLanguage } from "@/config/languages";

import Sidebar from "../components/layout/Sidebar";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import NotificationBanner from "@/components/layout/NotificationBanner";

import CursorManager from "@/components/providers/CursorManager";

import "../styles/main.css";

interface Props {
    title: string;
    description: string;
    canonical: string;
    dataGame?: string;
    game?: Game;
}

const { title, description, canonical, dataGame, game } = Astro.props;
---

<!doctype html>
<html lang={defaultLanguage}>
    <head>
        <ClientRouter />
        <script>
            import "@/i18n";
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta name="theme-color" content="#38365d" />

        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />

        <link
            rel="preload"
            href="/assets/fonts/GTAArtDecoRegular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/assets/fonts/GTAArtDecoMedium.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <link rel="manifest" href="/manifest.json" />
        <link rel="canonical" href={canonical} />

        <meta name="description" content={description} />

        <meta property="og:site_name" content="Vice Club" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content="https://www.viceclub.app/assets/images/app/og.webp"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="es_ES" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />

        <title>{title}</title>
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Vice Club",
                "url": "https://www.viceclub.app"
            }
        </script>
        <style is:global>
            :root {
                --sidebar-width: 88px;
                --header-height: 88px;
                --banner-height: 0px;
            }
        </style>
        <slot name="head" />
    </head>

    <body data-game={dataGame} id="top">
        <NotificationBanner client:load transition:persist />
        <Header transition:persist />
        <Sidebar
            client:load
            currentPath={Astro.url.pathname}
            transition:persist
        />

        <CursorManager gameId={game?.id} client:load />

        <div
            style={game
                ? `--game-accent: ${game.theme.accent.default};
                --game-accent-muted: ${game.theme.accent.muted};
                --game-buttons-primary-background: ${game.theme.buttons.primary.background};
                --game-buttons-primary-hovered: ${game.theme.buttons.primary.hovered};
                --game-buttons-primary-border: ${game.theme.buttons.primary.border};
                --game-buttons-primary-text: ${game.theme.buttons.primary.text};
                --game-buttons-secondary-background: ${game.theme.buttons.secondary.background};
                --game-buttons-secondary-hovered: ${game.theme.buttons.secondary.hovered};
                --game-buttons-secondary-border: ${game.theme.buttons.secondary.border};
                --game-buttons-secondary-text: ${game.theme.buttons.secondary.text};
            `
                : ""}
        >
            <slot />
        </div>

        <Footer />
        <slot name="scripts" />
    </body>
</html>
