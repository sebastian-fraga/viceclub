---
import { ClientRouter } from "astro:transitions";
import "../styles/main.css";

interface Props {
    title?: string;
}

const { title = "Page Not Found" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <meta name="theme-color" content="#38365d" />

        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="Vice Club" />
        <link rel="manifest" href="/site.webmanifest" />

        <title>{title}</title>
        <ClientRouter />
    </head>
    <body
        class="min-h-screen bg-[#0a0a0a] bg-linear-to-b from-[#221f3d] via-[#15131a] to-[#0a0a0a]"
    >
        <slot />
    </body>
</html>
